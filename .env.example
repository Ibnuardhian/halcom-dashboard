# Copy to `.env` and adjust. `.env` is git-ignored: never commit real values.
# Docker Compose reads it for variable interpolation in compose.yaml and
# compose.prod.yaml, and passes each container only the variables its service
# lists. Exception: the development app containers bind-mount the project, so
# Next.js also loads this file itself. Production images never contain it.

# --- PostgreSQL ---------------------------------------------------------------
# The password is embedded in DATABASE_URL, so use URL-safe characters only
# (A-Z a-z 0-9 - _ . ~). Generate one with: openssl rand -hex 24
# These values are applied only when the database volume is first created;
# changing them later does not change the stored credentials (README › Troubleshooting).
POSTGRES_USER=halcom
POSTGRES_PASSWORD=replace-with-a-random-hex-string
POSTGRES_DB=halcom

# --- Neon (optional; compose.neon.yaml) -----------------------------------------
# Neon Console > your project > Connect. Create the project with Postgres 18 (the
# migrations call uuidv7()). Keep "?sslmode=require" at the end of both addresses.
# NEON_DATABASE_URL: the POOLED address (host contains "-pooler"), used by the app.
# NEON_DIRECT_URL: the same without "-pooler", used for migrations, seed and backups.
# NEON_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# NEON_DIRECT_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require

# --- Sample accounts (development and test only) ------------------------------
# `npm run db:seed` creates the development accounts on the company domain, the same ones Neon has (superadmin@halcominovasi.co.id,
# admin@, satrio@ and dzaki@ (Sales), support@ (SOA), purchasing@, finance@, management@) with this
# password (at least 8 characters). The seed refuses to run outside development/test,
# and compose.prod.yaml never passes this variable. Do not reuse it anywhere real.
SEED_USER_PASSWORD=dev-only-change-me

# --- Development (compose.yaml) -------------------------------------------------
# Host ports, published on 127.0.0.1 only. PostgreSQL uses 55432 on the host so
# it does not clash with a locally installed PostgreSQL on 5432; containers
# still reach it as db:5432.
APP_HOST_PORT=3000
POSTGRES_HOST_PORT=55432

# Docker Desktop does not forward file-change events from Windows drives into Linux containers, so `next dev` can poll
# for changes every N ms (for example 1000) to hot-reload your edits. Polling made the page reload by itself every second
# on this setup (menus and buttons reset), so it is OFF by default: after editing code, run `docker compose restart app`.
NEXT_DEV_POLL_INTERVAL_MS=
# Extra host names the development server may be opened on (comma separated), for example this PC's LAN address when
# testing on a phone. 127.0.0.1 and localhost always work. Restart the app container after changing it.
ALLOWED_DEV_ORIGINS=

# --- Production (compose.prod.yaml) ---------------------------------------------
# Keep the app on loopback behind a TLS-terminating reverse proxy.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=3000

# --- Email text (brief §6.4) ----------------------------------------------------
# The application never sends email. A request page shows To, Cc, Subject and a default
# body for copy and paste into Outlook; the lists below fill To and Cc. Use clearly fake
# placeholder addresses here and keep the real distribution lists in your own `.env` or
# the deployment secret store. Separate addresses with commas or semicolons.
# A request type without a valid EMAIL_TO_* value shows a configuration error instead of
# recipients; it never falls back to another group's list.
EMAIL_TO_HITBOQ=soa-group@example.invalid
EMAIL_CC_HITBOQ=
EMAIL_TO_HITRFQ=purchasing-group@example.invalid
EMAIL_CC_HITRFQ=
EMAIL_TO_HITPO=purchasing-group@example.invalid
EMAIL_CC_HITPO=
# Public address of the application, used for the request link inside the email text.
# Development defaults to http://localhost:<APP_HOST_PORT>; production must set it.
# APP_BASE_URL=https://dashboard.example.invalid

# --- Database backups (superadmin > Backups) ------------------------------------
# Host folder that receives the dump files. Relative paths are resolved against the
# repository root. The folder is git-ignored. Back it up off the machine as well:
# a copy on the same disk does not survive a disk failure.
BACKUP_HOST_DIR=./backups
