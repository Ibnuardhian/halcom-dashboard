# Pin exact versions when adding dependencies; package-lock.json pins the rest.
save-exact=true
# Refuse installs on an unsupported Node.js/npm version (see package.json engines).
engine-strict=true

# Supply-chain cooldown: only resolve versions published at least 7 days ago.
min-release-age=7
# Temporary exemptions for security releases; remove them after 2026-10-23, when
# the pinned versions are older than the window.
# - Next.js 16.4.1+ fixes critical advisories (unauthenticated RCE in `use cache`
#   and in Image Optimization, DoS in Server Actions).
# - Prisma 7.10.1 upgrades mysql2 and deepmerge-ts to fix GHSA-3f6p-5ww8-9rcr,
#   GHSA-rgwj-5xj2-c3m3 and GHSA-ggr8-5vv4-36mx.
min-release-age-exclude[]=next
min-release-age-exclude[]=@next/*
min-release-age-exclude[]=eslint-config-next
min-release-age-exclude[]=prisma
min-release-age-exclude[]=@prisma/*

fund=false
update-notifier=false
