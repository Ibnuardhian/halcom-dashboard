# Copy to /opt/halcom/.env on the VPS (chmod 600, owner deploy) and fill it in. Never commit the real file.
# Docker Compose reads it next to compose.prod.yaml.

# --- PostgreSQL (applied when the volume is first created) ---------------------
# URL-safe characters only (A-Z a-z 0-9 - _ . ~). Generate with: openssl rand -hex 24
POSTGRES_USER=halcom
POSTGRES_PASSWORD=replace-with-a-random-hex-string
POSTGRES_DB=halcom

# --- Application ------------------------------------------------------------------
# The public address, used for links in the email text.
APP_BASE_URL=https://halcom.example.com
# Host folder for database dumps made from the Backups page. It must belong to uid 1000 (the node user in the image).
BACKUP_HOST_DIR=/opt/halcom/backups
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=3000

# Distribution lists shown in the email text (real addresses only here).
EMAIL_TO_HITBOQ=
EMAIL_CC_HITBOQ=
EMAIL_TO_HITRFQ=
EMAIL_CC_HITRFQ=
EMAIL_TO_HITPO=
EMAIL_CC_HITPO=

# APP_IMAGE, MIGRATE_IMAGE and IMAGE_TAG are set by deploy.sh for each deploy: do not put them here.
