// Prisma schema. Project/ticket models are intentionally not defined yet: they
// depend on open business decisions (docs/requirements/OPEN_QUESTIONS.md) and
// on the conceptual model in PROJECT_BRIEF_TICKETING_PROJECT_TRACKER.md §11.
// Add them through reviewed migrations (README › Database).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Keep in sync with ROLES in src/domain/access/roles.ts (a unit test enforces it).
enum Role {
  SUPERADMIN
  ADMIN
  SALES
  SOA
  PURCHASING
  FINANCE
  MANAGEMENT
}

model User {
  id           String   @id @default(uuid(7)) @db.Uuid
  name         String
  // Stored lower-cased; the migration adds a CHECK constraint enforcing it.
  email        String   @unique
  passwordHash String   @map("password_hash")
  // One role per user (assumption A-1 in docs/requirements/RBAC.md).
  role         Role
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions Session[]
  audits   AuditEvent[]

  @@map("users")
}

// Server-side login sessions. Only the SHA-256 of the cookie token is stored.
model Session {
  id        String   @id @default(uuid(7)) @db.Uuid
  tokenHash String   @unique @map("token_hash")
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// Append-only: the migration installs triggers that reject UPDATE, DELETE and
// TRUNCATE (brief §6.3 and §11 `audit_logs`).
model AuditEvent {
  id         String   @id @default(uuid(7)) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  before     Json?
  after      Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_events")
}
